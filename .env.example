# ── Server ───────────────────────────────────────────────
PORT=3001                      # 3000 is often taken (VS Code, other services)
HOST=127.0.0.1                 # this machine only. In the cloud (Phase 7): 0.0.0.0
PUBLIC_URL=            # public URL of the backend (ngrok or domain) e.g. https://xxxx.ngrok.app
LOG_FORMAT=text        # text (readable, dev) | json (production / log aggregators)

# ── OpenAI Realtime ──────────────────────────────────────
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-mini   # real-time voice model
OPENAI_VOICE=alloy                        # agent voice
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe  # transcribes the caller's audio (whisper-1 hallucinates on silence)
OPENAI_SUMMARY_MODEL=gpt-4o-mini          # writes the summary on hangup
OPENAI_RECONNECT_MAX_ATTEMPTS=3           # retries if the OpenAI WS drops (0 = no retry)

# ── Agent voice ──────────────────────────────────────────
VOICE_PROVIDER=openai          # openai (speech-to-speech) | elevenlabs (OpenAI text + ElevenLabs voice)
ELEVENLABS_API_KEY=            # only needed with VOICE_PROVIDER=elevenlabs
ELEVENLABS_VOICE_ID=           # voice id from the ElevenLabs voice library
ELEVENLABS_MODEL_ID=eleven_flash_v2_5   # lowest-latency multilingual model

# ── Twilio ───────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=          # number bought on Twilio (e.g. +352...)
MY_PERSONAL_NUMBER=           # your mobile, for transferring calls (e.g. +34...)

# ── Email (choose a provider) ────────────────────────────
EMAIL_PROVIDER=resend         # resend | sendgrid | ses
EMAIL_API_KEY=
EMAIL_FROM=agente@tudominio.com
EMAIL_TO=                      # your personal email to receive the summaries

# ── Agent settings ───────────────────────────────────────
MAX_CALL_SECONDS=600          # maximum call duration (cost guardrail)
MAX_CONCURRENT_CALLS=2        # maximum simultaneous calls (0 = no limit)
MAX_CALLS_PER_DAY=50          # calls accepted per day, UTC reset (0 = no limit)
SILENCE_TIMEOUT_SECONDS=20    # hang up on total silence for this long (0 = off)
MAX_CALLER_TURNS=40           # hang up if the caller exceeds these turns (0 = off)

# ── Security (Phase 6) ───────────────────────────────────
VALIDATE_TWILIO_SIGNATURE=true # validates X-Twilio-Signature on /incoming-call.
                               # Set to false ONLY for manual local testing.
STREAM_TOKEN_SECRET=           # secret for the token that authenticates /media-stream.
                               # Generate one: openssl rand -hex 32. Empty = no check (dev only).
STREAM_TOKEN_TTL_SECONDS=300   # stream token validity (seconds)
