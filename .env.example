# ── Servidor ─────────────────────────────────────────────
PORT=3001                      # 3000 suele estar ocupado (VS Code, otros servicios)
HOST=127.0.0.1                 # solo esta máquina. En la nube (Fase 7): 0.0.0.0
PUBLIC_URL=            # URL pública del backend (ngrok o dominio) ej: https://xxxx.ngrok.app

# ── OpenAI Realtime ──────────────────────────────────────
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-mini   # modelo de voz en tiempo real
OPENAI_VOICE=alloy                        # voz del agente
OPENAI_TRANSCRIBE_MODEL=whisper-1         # transcribe el audio del llamante
OPENAI_SUMMARY_MODEL=gpt-4o-mini          # redacta el resumen al colgar
OPENAI_RECONNECT_MAX_ATTEMPTS=3           # reintentos si el WS de OpenAI se cae (0 = no reintentar)

# ── Twilio ───────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=          # número comprado en Twilio (ej: +34...)
MY_PERSONAL_NUMBER=           # tu móvil, para transferir llamadas (ej: +34...)

# ── Email (elige un proveedor) ───────────────────────────
EMAIL_PROVIDER=resend         # resend | sendgrid | ses
EMAIL_API_KEY=
EMAIL_FROM=agente@tudominio.com
EMAIL_TO=                      # tu email personal para recibir los resúmenes

# ── Ajustes del agente ───────────────────────────────────
MAX_CALL_SECONDS=600          # duración máxima de llamada (guardarraíl de coste)
MAX_CONCURRENT_CALLS=2        # llamadas simultáneas máximas (0 = sin límite)
MAX_CALLS_PER_DAY=50          # llamadas aceptadas por día, reinicio UTC (0 = sin límite)
SILENCE_TIMEOUT_SECONDS=20    # cuelga si hay silencio total este tiempo (0 = off)
MAX_CALLER_TURNS=40           # cuelga si el llamante supera estos turnos (0 = off)

# ── Seguridad (Fase 6) ───────────────────────────────────
VALIDATE_TWILIO_SIGNATURE=true # valida X-Twilio-Signature en /incoming-call.
                               # Ponlo a false SOLO para pruebas locales manuales.
STREAM_TOKEN_SECRET=           # secreto para el token que autentica /media-stream.
                               # Genera uno: openssl rand -hex 32. Vacío = sin verificar (solo dev).
STREAM_TOKEN_TTL_SECONDS=300   # validez del token del stream (segundos)
